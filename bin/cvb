#!/usr/bin/env Rscript
source("R/cvb.R")
a <- commandArgs(TRUE)
con <- connect_db(); on.exit(disconnect(con))
switch(a[1],
  init = init(con),
  `import-legacy` = import_legacy(con, a[2], if (length(a) > 2) a[3] else projects()[[a[2]]]$legacy_dir),
  build = {
    f <- which(a == "--file"); src <- if (length(f)) a[f + 1] else projects()[[a[2]]]$sheet
    build(con, a[2], src, dry_run = "--dry-run" %in% a)
  },
  views = refresh_views(con, a[2]),
  validate = { r <- validate(con, a[2]); if (any(r$severity == "error" & r$violations > 0)) quit(status = 1) },
  export = export(con, a[2]),
  stop("usage: cvb init | import-legacy <project> [dir] | build <project> [--dry-run] [--file csv] | views <project> | validate <project> | export <project>"))
